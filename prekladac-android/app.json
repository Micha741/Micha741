{
  "expo": {
    "name": "Překladač knih",
    "slug": "prekladac",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F0FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.micha741.prekladac",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/epub+zip"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-mobipocket-ebook"
            },
            {
              "scheme": "content",
              "mimeType": "application/vnd.amazon.mobi8-ebook"
            },
            {
              "scheme": "content",
              "mimeType": "application/vnd.palm"
            },
            {
              "scheme": "content",
              "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
              "scheme": "content",
              "mimeType": "text/plain"
            },
            {
              "scheme": "content",
              "mimeType": "text/html"
            },
            {
              "scheme": "content",
              "mimeType": "application/octet-stream"
            },
            {
              "scheme": "file",
              "mimeType": "application/epub+zip"
            },
            {
              "scheme": "file",
              "mimeType": "application/x-mobipocket-ebook"
            },
            {
              "scheme": "file",
              "mimeType": "application/vnd.amazon.mobi8-ebook"
            },
            {
              "scheme": "file",
              "mimeType": "application/vnd.palm"
            },
            {
              "scheme": "file",
              "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
              "scheme": "file",
              "mimeType": "text/plain"
            },
            {
              "scheme": "file",
              "mimeType": "text/html"
            },
            {
              "scheme": "file",
              "mimeType": "application/octet-stream"
            },
            {
              "scheme": "content",
              "mimeType": "application/json"
            },
            {
              "scheme": "file",
              "mimeType": "application/json"
            },
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "file",
              "mimeType": "application/pdf"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikace potřebuje přístup k fotkám, abyste mohli vložit obrázek nebo obálku do knihy.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "owner": "micha741",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.micha741.prekladac"
    },
    "backgroundColor": "#1e293b",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#1e293b"
    },
    "extra": {
      "eas": {
        "projectId": "cc32578f-eecd-4640-a6ab-49a737d994d4"
      }
    }
  }
}
